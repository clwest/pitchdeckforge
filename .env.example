# PitchDeckForge — environment variables
#
# Copy to .env and fill in. .env is gitignored.
#
# ── Required for any non-trivial usage ───────────────────────────────────
OPENAI_API_KEY=your-openai-key-here
SECRET_KEY=replace-me-with-a-long-random-string

# ── Model selection ──────────────────────────────────────────────────────
AI_MODEL=gpt-5-mini

# ── Database ─────────────────────────────────────────────────────────────
# Native (host) dev with SQLite (default in code if unset):
# DATABASE_URL=sqlite:///./pitchdeckforge.db
#
# Docker compose mode (default in docker-compose.yml — overrides via env):
# DATABASE_URL is auto-set to postgresql://pitchdeckforge:pitchdeckforge@pitchdeckforge_postgres:5432/pitchdeckforge
DATABASE_URL=

# ── Postgres credentials (only consumed by docker-compose.yml) ──────────
POSTGRES_DB=pitchdeckforge
POSTGRES_USER=pitchdeckforge
# Local-dev placeholder. Override via .env or a real secret store before any deploy.
POSTGRES_PASSWORD=change-me-in-production

# ── CORS / frontend URL ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5176
ALLOWED_ORIGINS=http://localhost:5176

# ── Frontend build-time API URL (consumed by Vite at image-build time) ──
VITE_API_URL=http://localhost:8004/api

# ── Brain bridge (proxy questions to u-d-b's Rigby PA) ───────────────────
# host.docker.internal resolves to native u-d-b on the host (Docker
# Desktop wires this automatically; compose adds extra_hosts for Linux).
BRAIN_URL=http://host.docker.internal:8000
# Required for the brain bridge to function. Local-donkeyking PA token.
BRAIN_TOKEN=
# Optional — pin all brain calls to one conversation thread.
BRAIN_CONVERSATION=

# ── Stripe (optional — billing routes degrade gracefully if unset) ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
